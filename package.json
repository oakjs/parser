{
  "name": "spell-parser",
  "repository": "https://github.com/oakjs/parser",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "browserslist": "> 1%, node > 20",
  "scripts": {
    "docker": "docker compose up",
    "docker-bg": "docker compose up --detach",
    "docker-build": "docker compose build",
    "dev": "vite",
    "server": "tsx watch src/server/index.ts",
    "server:prod": "tsx src/server/index.ts",
    "start": "concurrently \"yarn dev\" \"yarn server\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf ./.cache; rm -rf ./build"
  },
  "dependencies": {
    "@reach/router": "^1.3.4",
    "@risingstack/react-easy-state": "^6.3.0",
    "any-base": "^1.1.0",
    "assert": "^2.0.0",
    "body-parser": "^1.19.0",
    "browser-or-node": "^3.0.0",
    "chalk": "^2.4.2",
    "classnames": "^2.2.6",
    "codemirror": "^5.48.2",
    "express": "^4.18.2",
    "express-json5": "^0.1.0",
    "fs-extra": "^11.3.0",
    "global": "^4.3.2",
    "history": "^4.7.2",
    "jshint": "^2.10.2",
    "json5": "^2.1.1",
    "languages": "^0.1.3",
    "lodash": "^4.17.21",
    "lodash-inflection": "^1.5.0",
    "node-filter-async": "^3.0.0",
    "path": "^0.12.7",
    "prop-types": "^15.8.1",
    "proper-lockfile": "^3.2.0",
    "query-string": "^6.12.1",
    "react": "^18.2.0",
    "react-codemirror2": "^8.0.1",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^2.1.3",
    "react-keydown": "^1.7.2",
    "react-router-dom": "^6.22.3",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.5",
    "uuid": "^8.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.17",
    "@types/node": "^20.11.24",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "less": "^3.9.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
